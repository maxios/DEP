{
  "name": "@dep/cli",
  "version": "0.3.0",
  "description": "CLI tool for the Documentation Engineering Protocol",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "dep": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:local": "bun run scripts/build.ts --local",
    "test": "bun test",
    "test:stories": "bun --bun cucumber-js",
    "test:all": "bun test && bun --bun cucumber-js"
  },
  "private": true,
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.3"
  }
}
